# Production Environment Variables
# Fill in your actual production values

# ==============================================
# REQUIRED - Notion Integration (Public Identifier Only)
# IMPORTANT: The Notion client secret must NOT be placed in extension env files; keep it server-side only.
# ==============================================
VITE_NOTION_CLIENT_ID=your_notion_client_id_here

# ==============================================
# OPTIONAL - AI Features
# ==============================================
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_OPENAI_MODEL=gpt-3.5-turbo
VITE_OPENAI_MAX_TOKENS=150

# ==============================================
# PRODUCTION CONFIGURATION
# ==============================================
VITE_APP_NAME=Bookmark Notion Sync
VITE_APP_VERSION=0.1.0
VITE_DEBUG_MODE=false

# Content Extraction Settings
VITE_MAX_CONTENT_LENGTH=5000
VITE_EXTRACTION_TIMEOUT=10000

# Sync Settings
VITE_AUTO_SYNC_ENABLED=true
VITE_BATCH_SIZE=10
VITE_SYNC_DELAY=1000

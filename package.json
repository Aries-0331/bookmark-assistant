{
  "name": "bookmark-assistant",
  "version": "0.1.0",
  "description": "AI assistant for managing bookmarks and syncing with Notion",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -F @bookmark-assistant/extension dev",
    "dev:server": "pnpm -F @bookmark-assistant/server dev",
    "build": "pnpm -F @bookmark-assistant/extension build",
    "build:server": "pnpm -F @bookmark-assistant/server build",
    "build:all": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "clean:legacy": "bash scripts/cleanup-legacy-dist.sh",
    "start:server": "pnpm -F @bookmark-assistant/server start"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.9.2",
    "prettier": "^3.0.0",
    "eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Aries",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/bookmark-notion-sync"
  }
}

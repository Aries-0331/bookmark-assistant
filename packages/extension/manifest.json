{
  "manifest_version": 3,
  "name": "Bookmark Notion Sync",
  "version": "0.1.0",
  "description": "Sync Chrome bookmarks to Notion with optional server-assisted OAuth and content extraction.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "bookmarks",
    "storage",
    "identity",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://api.notion.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  },
  "options_page": "options.html",

  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "assets/*",
        "popup.html",
        "options.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "minimum_chrome_version": "91"
}

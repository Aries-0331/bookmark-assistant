{
  "manifest_version": 3,
  "name": "Bookmark Notion Sync",
  "version": "0.1.0",
  "description": "Sync Chrome bookmarks to Notion with optional server-assisted OAuth and content extraction.",
  "permissions": [
    "bookmarks",
    "storage",
    "identity",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://api.notion.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Bookmark Notion Sync"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "assets/*",
        "options.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "minimum_chrome_version": "91"
}

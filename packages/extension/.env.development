# Development Environment Variables
# For local development with local server

# OAuth Server Configuration
VITE_OAUTH_SERVER_URL=http://localhost:3333

# Notion Integration (Extension-side only)
VITE_NOTION_CLIENT_ID=257d872b-594c-805a-9f58-0037c0162612
# Redirect URI is computed via chrome.identity.getRedirectURL at runtime

# AI Services (OpenAI)
VITE_OPENAI_API_KEY=sk-your_actual_openai_api_key_here
VITE_OPENAI_MODEL=gpt-3.5-turbo
VITE_OPENAI_MAX_TOKENS=150

# Extension Configuration
VITE_APP_NAME=Bookmark Assistant
VITE_APP_VERSION=0.1.0
VITE_DEBUG_MODE=true
VITE_EDITION=free

# Content Extraction Settings
VITE_MAX_CONTENT_LENGTH=5000
VITE_EXTRACTION_TIMEOUT=10000

# Sync Settings
VITE_AUTO_SYNC_ENABLED=true
VITE_BATCH_SIZE=10
VITE_SYNC_DELAY=1000

VITE_PADDLE_CLIENT_TOKEN=test_daa8f31982ed83f8c50ad77b09e
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_PRO_MONTHLY_PRICE_ID=pri_01k9vgq1perm55xaqvmqm1qyav

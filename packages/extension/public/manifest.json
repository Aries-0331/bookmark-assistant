{
  "manifest_version": 3,
  "name": "Bookmark Assistant - Notion Bookmark Manager & Web Clipper",
  "version": "1.0.16",
  "default_locale": "en",
  "description": "One-click sync Chrome bookmarks to Notion Database. Auto-fetch favicons, meta tags, and manage your knowledge base visually.",
  "permissions": ["bookmarks", "storage", "identity", "alarms", "contextMenus", "notifications"],
  "host_permissions": [],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extensionTitle__",
    "default_icon": {
      "16": "assets/favicon/favicon-16x16.png",
      "32": "assets/favicon/favicon-32x32.png",
      "48": "assets/favicon/android-chrome-192x192.png",
      "128": "assets/favicon/android-chrome-512x512.png"
    }
  },
  "icons": {
    "16": "assets/favicon/favicon-16x16.png",
    "32": "assets/favicon/favicon-32x32.png",
    "48": "assets/favicon/android-chrome-192x192.png",
    "128": "assets/favicon/android-chrome-512x512.png"
  },
  "options_page": "options.html"
}

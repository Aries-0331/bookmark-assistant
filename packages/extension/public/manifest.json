{
  "manifest_version": 3,
  "name": "Bookmark Assistant",
  "version": "0.1.0",
  "description": "AI-assistant for managing bookmarks and syncing with Notion",
  "permissions": [
    "bookmarks",
    "storage",
    "identity",
    "activeTab",
    "scripting",
    "notifications",
    "alarms"
  ],
  "host_permissions": ["https://api.notion.com/*", "<all_urls>"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Bookmark Assistant",
    "default_icon": {
      "16": "assets/favicon/favicon-16x16.png",
      "32": "assets/favicon/favicon-32x32.png",
      "48": "assets/favicon/android-chrome-192x192.png",
      "128": "assets/favicon/android-chrome-512x512.png"
    }
  },
  "icons": {
    "16": "assets/favicon/favicon-16x16.png",
    "32": "assets/favicon/favicon-32x32.png",
    "48": "assets/favicon/android-chrome-192x192.png",
    "128": "assets/favicon/android-chrome-512x512.png"
  },
  "options_page": "options.html",
  "content_scripts": []
}

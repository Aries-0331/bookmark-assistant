{
  "manifest_version": 3,
  "name": "Bookmark Assistant",
  "version": "1.0.7",
  "description": "Transform Chrome bookmarks into organized Notion databases. One-click sync, smart descriptions, auto-sync Pro features.",
  "permissions": ["bookmarks", "storage", "identity", "alarms"],
  "host_permissions": [],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Bookmark Assistant",
    "default_icon": {
      "16": "assets/favicon/favicon-16x16.png",
      "32": "assets/favicon/favicon-32x32.png",
      "48": "assets/favicon/android-chrome-192x192.png",
      "128": "assets/favicon/android-chrome-512x512.png"
    }
  },
  "icons": {
    "16": "assets/favicon/favicon-16x16.png",
    "32": "assets/favicon/favicon-32x32.png",
    "48": "assets/favicon/android-chrome-192x192.png",
    "128": "assets/favicon/android-chrome-512x512.png"
  },
  "options_page": "options.html"
}

{
  "manifest_version": 3,
  "name": "Bookmark Assistant - Notion Bookmark Sync",
  "version": "1.0.19",
  "default_locale": "en",
  "description": "Sync Chrome bookmarks and Reading List items to Notion. Save pages, fetch link metadata, and keep saved links organized.",
  "permissions": [
    "bookmarks",
    "readingList",
    "activeTab",
    "storage",
    "identity",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extensionTitle__",
    "default_icon": {
      "16": "assets/favicon/favicon-16x16.png",
      "32": "assets/favicon/favicon-32x32.png",
      "48": "assets/favicon/android-chrome-192x192.png",
      "128": "assets/favicon/android-chrome-512x512.png"
    }
  },
  "icons": {
    "16": "assets/favicon/favicon-16x16.png",
    "32": "assets/favicon/favicon-32x32.png",
    "48": "assets/favicon/android-chrome-192x192.png",
    "128": "assets/favicon/android-chrome-512x512.png"
  },
  "options_page": "options.html"
}

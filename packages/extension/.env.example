# Environment Variables Template
# Copy this file to .env.development and .env.production and fill in your values

# ==============================================
# REQUIRED VARIABLES
# ==============================================

# Notion Integration Credentials
# Get these from: https://www.notion.so/my-integrations
VITE_NOTION_CLIENT_ID=your_notion_client_id_here
VITE_NOTION_CLIENT_SECRET=your_notion_client_secret_here

# ==============================================
# OPTIONAL VARIABLES (AI Features)
# ==============================================

# OpenAI API Configuration
# Get API key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_OPENAI_MODEL=gpt-3.5-turbo
VITE_OPENAI_MAX_TOKENS=150

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================

# Extension Metadata
VITE_APP_NAME=Bookmark Notion Sync
VITE_APP_VERSION=0.1.0

# Debug Settings (true for development, false for production)
VITE_DEBUG_MODE=true

# ==============================================
# FEATURE CONFIGURATION
# ==============================================

# Content Extraction Settings
VITE_MAX_CONTENT_LENGTH=5000
VITE_EXTRACTION_TIMEOUT=10000

# Sync Behavior
VITE_AUTO_SYNC_ENABLED=true
VITE_BATCH_SIZE=10
VITE_SYNC_DELAY=1000

# ==============================================
# CHROME EXTENSION SETTINGS
# ==============================================

# OAuth Redirect URI (auto-generated if not provided)
# Format: chrome-extension://YOUR_EXTENSION_ID/notion
# VITE_NOTION_REDIRECT_URI=chrome-extension://abcdefghijklmnopqrstuvwxyz123456/notion

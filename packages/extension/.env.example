# Extension Environment Variables

# OAuth Server URL
VITE_OAUTH_SERVER_URL=http://localhost:3333

# Paddle Payment Configuration (Sandbox)
VITE_PADDLE_CLIENT_TOKEN=test_xxx  # Get from Paddle Dashboard > Developer tools > Authentication
VITE_PADDLE_ENVIRONMENT=sandbox  # or 'production'
VITE_PADDLE_PRO_MONTHLY_PRICE_ID=pri_xxx  # Get from Paddle Dashboard > Catalog > Prices
VITE_PADDLE_PRO_YEARLY_PRICE_ID=pri_xxx  # Get from Paddle Dashboard > Catalog > Prices

# Billing URLs (optional, uses VITE_OAUTH_SERVER_URL by default)
# VITE_BILLING_URL=http://localhost:3333

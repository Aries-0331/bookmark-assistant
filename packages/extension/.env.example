# Chrome Extension Environment Variables
# These variables are embedded at build time by Vite

# OAuth Server Configuration
VITE_OAUTH_SERVER_URL=https://your-api-domain.vercel.app

# Notion OAuth Application
VITE_NOTION_CLIENT_ID=your-notion-client-id

# Website URL (for payment success redirects)
VITE_WEBSITE_URL=https://your-website-domain.vercel.app

# Optional: Support/Billing URLs
VITE_SUPPORT_URL=https://your-website-domain.vercel.app/support
VITE_BILLING_URL=https://your-api-domain.vercel.app/billing

# Debug Settings (optional)
VITE_DEBUG_MODE=false
VITE_APP_NAME=Bookmark Assistant
VITE_APP_VERSION=1.0.7

# Note: Paddle checkout is handled server-side
# No Paddle variables needed in extension build

{
  "name": "@bookmark-assistant/extension",
  "version": "1.0.3",
  "description": "Transform Chrome bookmarks into organized Notion databases. One-click sync, smart descriptions, auto-sync Pro features.",
  "type": "module",
  "scripts": {
    "dev": "vite --open /src/dev/index.html",
    "build": "tsc -b && vite build --mode development",
    "build:prod": "tsc -b && vite build --mode production",
    "clean": "rm -rf dist",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@bookmark-assistant/shared": "workspace:*",
    "@notionhq/client": "^5.0.0",
    "lucide-react": "^0.546.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@samrum/vite-plugin-web-extension": "^5.1.1",
    "@types/chrome": "^0.0.254",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.1.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.9.2",
    "vite": "^5.0.8",
    "zustand": "^4.5.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

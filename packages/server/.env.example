# Server Configuration
PORT=3333
NODE_ENV=development
isPro=false
WEBSITE_URL=http://localhost:3006  # Your website URL for success redirects

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ALLOWED_EXTENSION_ID=your-chrome-extension-id

# Notion API Configuration
NOTION_CLIENT_ID=your-notion-oauth-client-id
NOTION_CLIENT_SECRET=your-notion-oauth-client-secret
NOTION_API_VERSION=2025-09-03

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Pricing & Limits Configuration
# ⚠️ IMPORTANT: Pricing is now fetched from Paddle API
# The values below are FALLBACK ONLY (used if Paddle API is unavailable)
# To change pricing, update it in your Paddle Dashboard
FREE_DAILY_LIMIT=100
FREE_INTERVAL_HOURS=12
PRO_DAILY_LIMIT=1000
PRO_INTERVAL_HOURS=0.5

# Paddle Payment Configuration (Sandbox for testing)
PADDLE_API_KEY=test_xxx  # Get from Paddle Dashboard > Developer tools > Authentication
PADDLE_ENVIRONMENT=sandbox  # or 'production'
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxx  # Get from Paddle Dashboard > Notifications
PADDLE_PRO_MONTHLY_PRICE_ID=pri_xxx  # Get from Paddle Dashboard > Catalog > Prices
PADDLE_PRO_YEARLY_PRICE_ID=pri_xxx  # Get from Paddle Dashboard > Catalog > Prices

# Frontend Client-Side Token (used by extension/website)
# Note: This goes in the frontend .env file, not server
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxx
# NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

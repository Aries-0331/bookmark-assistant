{
  "name": "@bookmark-assistant/server",
  "version": "1.0.19",
  "description": "Secure OAuth server for Bookmark Assistant Chrome extension",
  "main": "dist/index.js",
  "scripts": {
    "dev": "prisma generate && nodemon --exec ts-node src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "deploy": "npm run build && node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "oauth",
    "notion",
    "chrome-extension",
    "security"
  ],
  "author": "Aries",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@bookmark-assistant/contracts": "workspace:*",
    "@notionhq/client": "^5.3.0",
    "@prisma/client": "^6.17.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.17.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": "20.x"
  }
}

// Prisma schema for Bookmark Notion Sync

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id               String   @id
  email                 String?  @unique
  notion_access_token   String
  notion_refresh_token  String?
  notion_workspace_id   String?
  bot_id                String?
  duplicated_template_id String?
  notion_database_id    String?
  notion_data_source_id String?
  template_database_id  String?
  databases             Json?

  // Paddle Payment Integration
  plan                  String   @default("free") // "free" | "pro"
  paddleCustomerId      String?  @unique
  paddleSubscriptionId  String?  @unique
  subscriptionStatus    String?  // "trialing" | "active" | "past_due" | "paused" | "canceled"
  nextBilledAt          DateTime?

  last_activity         DateTime @default(now())
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@index([paddleCustomerId])
  @@index([paddleSubscriptionId])
  @@index([email])
}

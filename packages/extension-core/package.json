{
  "name": "@bookmark-assistant/extension-core",
  "version": "0.1.1",
  "description": "Pure extension-side core helpers for Bookmark Assistant.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm -F @bookmark-assistant/contracts build",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bookmark-assistant/contracts": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.0.15"
  }
}

# Website Environment Variables

# Paddle Payment Configuration (Sandbox)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxx  # Get from Paddle Dashboard > Developer tools > Authentication
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox  # or 'production'
NEXT_PUBLIC_PADDLE_PRO_MONTHLY_PRICE_ID=pri_xxx  # Get from Paddle Dashboard > Catalog > Prices
NEXT_PUBLIC_PADDLE_PRO_YEARLY_PRICE_ID=pri_xxx  # Get from Paddle Dashboard > Catalog > Prices

{
  "name": "bookmark-notion-sync",
  "version": "1.0.0",
  "description": "Chrome extension that syncs bookmarks to Notion with AI features",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/extension",
    "dev:server": "npm run dev --workspace=packages/server",
    "build": "npm run build --workspace=packages/extension",
    "build:server": "npm run build --workspace=packages/server",
    "build:all": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "clean": "npm run clean --workspaces",
    "start:server": "npm run start --workspace=packages/server"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.9.2",
    "prettier": "^3.0.0",
    "eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/bookmark-notion-sync"
  }
}
